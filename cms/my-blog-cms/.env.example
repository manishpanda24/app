# Local Mongo (e.g. docker compose up -d in this folder)
DATABASE_URL=mongodb://127.0.0.1:27017/amg-blog-cms

# Remote Atlas — use legacy mongodb:// on Vercel (not mongodb+srv://) to avoid querySrv DNS issues.
# In Atlas: Connect → Drivers → copy the "Standard connection string" (mongodb://...).
# MONGODB_URI=mongodb://user:pass@cluster0-shard-00-00.xxxxx.mongodb.net:27017,cluster0-shard-00-01.xxxxx.mongodb.net:27017,cluster0-shard-00-02.xxxxx.mongodb.net:27017/blog_cms?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin

# If Atlas fails with querySrv ECONNREFUSED (DNS/VPN/firewall), use local Mongo:
# MONGO_USE_LOCAL=true

PAYLOAD_SECRET=replace-with-a-long-random-string

# Production (Vercel): set to your deployment URL, no trailing slash
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# CRA / production frontend origin (CORS / CSRF)
FRONTEND_ORIGIN=http://localhost:3001

# Extra allowed origins (comma-separated), e.g. your Vercel frontend URL
# CORS_ORIGINS=https://your-frontend.vercel.app,https://www.amgvp.com

# Cloudflare R2 / S3 — set ALL four variables for remote storage, or leave ALL unset for local disk storage.
# Partial configuration will be ignored and local storage will be used instead.
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET=
